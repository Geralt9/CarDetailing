{
  "name": "bluewater-detailing",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "db:reset": "npm run db:reset -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
